    "clients:install": "node src/index.js install-detected --confirm",
    "test": "node --test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "express": "^4.19.2",
    "jsonc-parser": "^3.3.1",
    "lucide-static": "^1.24.0",
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=18"
  }
}
